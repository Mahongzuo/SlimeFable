{
  "_meta": {
    "description": "Flat API prompt for MiniMax Music 3 theme songs. Patched at runtime.",
    "source_ui": "audio_minimax_music_3.json"
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_music3_dit_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "minimax_music3_text_encoder_pruned_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_music3_dav.safetensors"
    }
  },
  "4": {
    "class_type": "MiniMaxMusic3TextEncode",
    "inputs": {
      "clip": ["2", 0],
      "caption": "__CAPTION__",
      "lyrics": "__LYRICS__",
      "seed": 0,
      "max_duration": 90.0,
      "cfg_scale": 1.5,
      "top_k": 50
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": ["4", 0]
    }
  },
  "6": {
    "class_type": "EmptyMiniMaxMusic3LatentAudio",
    "inputs": {
      "seconds": ["4", 1],
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": 0,
      "steps": 30,
      "cfg": 1.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "SaveAudioMP3",
    "inputs": {
      "audio": ["8", 0],
      "filename_prefix": "slimefable/theme",
      "quality": "V0"
    }
  }
}
